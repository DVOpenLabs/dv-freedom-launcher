<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Preserve the existing same-signer pilots' previously granted local weather bridge. -->
    <uses-permission android:name="com.dvopenlabs.cytv.weatherpreview.READ_WEATHER" />
    <uses-permission android:name="com.dvopenlabs.freedom.companions.READ" />
    <queries><package android:name="com.dvopenlabs.freedom.companions" /><package android:name="com.dvopenlabs.freedom.remote" /><package android:name="io.github.sumyabazar1.weather" /><package android:name="com.dvopenlabs.cytv.weatherpreview" /></queries>
    <application android:label="@string/freedom_app_name" android:theme="@style/Theme.Freedom" tools:replace="android:label,android:theme">
        <meta-data android:name="com.dvopenlabs.weather.CLIENT" android:value="true" />
        <service android:name="com.gathin.tvhome.FamilyGuard" android:label="@string/family_guard_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/family_guard" />
        </service>
        <provider android:name="com.gathin.tvhome.MediaInboxProvider" android:authorities="${applicationId}.inbox" android:exported="true" android:permission="android.permission.WRITE_SECURE_SETTINGS" android:grantUriPermissions="false" />
        <activity android:name="com.gathin.tvhome.MediaReviewActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name="com.gathin.tvhome.NowPlayingActivity" android:exported="false" android:screenOrientation="landscape" />
        <service android:name="com.gathin.tvhome.MediaAccessService" android:label="DV Freedom media access" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
            <meta-data android:name="android.service.notification.default_filter_types" android:value="" />
        </service>
        <activity android:name="com.gathin.tvhome.CategoryHomeActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode" />
        <activity android:name="com.gathin.tvhome.ExperienceHomeActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode" />
        <activity android:name="com.gathin.tvhome.ContentShelfActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name="com.gathin.tvhome.WallpaperStudioActivity" android:exported="false" android:screenOrientation="landscape" />
        <provider android:name="com.gathin.tvhome.PhoneSetupProvider" android:authorities="${applicationId}.phone-setup" android:exported="true" />
        <activity android:name="com.gathin.tvhome.GuidedSetupActivity" android:exported="false" android:screenOrientation="landscape" />
        <activity android:name="com.gathin.tvhome.InstallerPreviewActivity" android:exported="false" android:screenOrientation="landscape" android:theme="@style/Freedom.InstallerPreview" />
    </application>
</manifest>
