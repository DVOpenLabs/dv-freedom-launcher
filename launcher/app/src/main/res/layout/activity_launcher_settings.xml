<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/settingsPanes" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="#FF111215">
    <ScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="#FF1B1D21" android:focusable="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="64dp" android:paddingEnd="48dp" android:paddingTop="64dp" android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/launcher_settings" android:textSize="15sp" android:textColor="#FFB7BEC8" android:fontFamily="@string/font_regular" />
        <TextView android:id="@+id/settingsSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/settings_layout" android:textSize="32sp" android:textColor="#FFF4F5F7" android:fontFamily="@string/font_medium" />
        <TextView android:id="@+id/settingsContext" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textSize="22sp" android:textColor="#FFF4F5F7" android:fontFamily="@string/font_medium" android:visibility="gone" />
        <TextView android:id="@+id/settingsSectionHelp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/settings_layout_help" android:textSize="17sp" android:textColor="#FFCDD2D9" android:lineSpacingExtra="5dp" android:fontFamily="@string/font_regular" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:text="@string/settings_navigation_help" android:textSize="13sp" android:textColor="#FFABB3BF" android:lineSpacingExtra="4dp" android:fontFamily="@string/font_regular" />
    </LinearLayout>
    </ScrollView>
    <FrameLayout android:layout_width="420dp" android:layout_height="match_parent" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="92dp" android:paddingBottom="28dp">
        <LinearLayout android:id="@+id/settingsCategories" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/SettingsCategory" android:id="@+id/categoryLayout" android:text="@string/settings_layout" android:drawableStart="@drawable/ic_home_settings" android:drawableEnd="@drawable/ic_chevron" />
            <TextView style="@style/SettingsCategory" android:id="@+id/categoryApps" android:text="@string/settings_apps" android:drawableStart="@drawable/ic_apps" android:drawableEnd="@drawable/ic_chevron" />
            <TextView style="@style/SettingsCategory" android:id="@+id/categoryWallpaper" android:text="@string/settings_wallpaper" android:drawableStart="@drawable/ic_picture" android:drawableEnd="@drawable/ic_chevron" />
            <TextView style="@style/SettingsCategory" android:id="@+id/categoryRemote" android:text="@string/settings_remote" android:drawableStart="@drawable/ic_input" android:drawableEnd="@drawable/ic_chevron" />
            <TextView style="@style/SettingsCategory" android:id="@+id/categoryAdvanced" android:text="@string/settings_advanced" android:drawableStart="@drawable/ic_settings" android:drawableEnd="@drawable/ic_chevron" />
        </LinearLayout>
        <ScrollView android:id="@+id/settingsScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="false" android:scrollbarStyle="outsideOverlay">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/groupLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible" android:paddingBottom="24dp">
                        <TextView android:id="@+id/positionChoice" style="@style/SettingsRow" android:layout_marginBottom="16dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/columns_label" android:textColor="#FFFFFFFF" android:textSize="20sp" android:id="@+id/settingsColumnsCaption" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                    <TextView android:id="@+id/columns8" style="@style/SettingsColumnChoice" android:text="8" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/rows_below_dock_label" android:textColor="#FFFFFFFF" android:textSize="20sp" android:id="@+id/settingsRowsCaption" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/dock_opacity_label" android:textColor="#FFFFFFFF" android:textSize="20sp" android:id="@+id/settingsOpacityCaption" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
                        </LinearLayout>
                        <TextView android:id="@+id/focusOutlineChoice" style="@style/SettingsRow" android:layout_marginTop="16dp" android:visibility="gone" />
                        <TextView android:id="@+id/tileSpacingChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:visibility="gone" />
                        <TextView android:id="@+id/stylesChoice" style="@style/SettingsRow" android:layout_marginTop="16dp" android:text="@string/home_styles" android:visibility="gone" />
                        <TextView android:id="@+id/styleUndoChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/style_undo" android:visibility="gone" />
                        <TextView android:id="@+id/cinematicIdleChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" />
                        <TextView android:id="@+id/previewIdleChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/cinematic_preview" />
                        <TextView android:id="@+id/adaptiveHeaderChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                        <TextView android:id="@+id/appNamesChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                        <TextView android:id="@+id/refinedMotionChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                        <TextView android:id="@+id/animationsChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/groupApps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="24dp">
                        <TextView android:id="@+id/reorderChoice" style="@style/SettingsRow" android:layout_marginTop="0dp" android:text="@string/reorder" android:visibility="gone" />
                        <TextView style="@style/SettingsRow" android:id="@+id/findAppsChoice" android:text="@string/find_apps" android:layout_marginTop="10dp" />
                        <TextView android:id="@+id/recentAppsChoice" style="@style/SettingsRow" android:layout_marginTop="16dp" />
                        <TextView android:id="@+id/clearRecentChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/recent_clear" />
                        <TextView android:id="@+id/profilesChoice" style="@style/SettingsRow" android:layout_marginTop="16dp" android:text="@string/local_profiles" android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/groupWallpaper" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="24dp">
                        <TextView android:id="@+id/wallpaperDimChoice" style="@style/SettingsRow" android:layout_marginBottom="10dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wallpaper_dim_help" android:textColor="#FFBDCAD4" android:textSize="14sp" android:layout_marginBottom="16dp" />
                        <TextView android:id="@+id/themesChoice" style="@style/SettingsRow" android:layout_marginTop="0dp" android:text="@string/theme_library" android:visibility="gone" />
                        <TextView android:id="@+id/liveWallpaperChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:visibility="gone" />
                        <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/groupRemote" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="24dp">
                        <TextView style="@style/SettingsRow" android:id="@+id/inputsShortcutChoice" android:text="@string/inputs_shortcut" />
                        <TextView android:id="@+id/inputVisibilityChoice" style="@style/SettingsRow" android:layout_marginTop="0dp" android:visibility="gone" />
                        <TextView android:id="@+id/tvButtonChoice" style="@style/SettingsRow" android:layout_marginTop="16dp" android:text="@string/tv_button" android:visibility="gone" />
                        <TextView android:id="@+id/tvButtonHelper" style="@style/SettingsRow" android:layout_marginTop="10dp" android:layout_height="wrap_content" android:minHeight="52dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:textSize="16sp" android:visibility="gone" />
                        <TextView android:id="@+id/bluetoothChoice" style="@style/SettingsRow" android:layout_marginTop="16dp" android:text="@string/bluetooth_pairing" />
                        <TextView android:id="@+id/quickActionsChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/quick_actions" />
                        <TextView android:id="@+id/audioIndicatorChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/groupAdvanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="24dp">
                        <TextView android:id="@+id/savedSetupsChoice" style="@style/SettingsRow" android:layout_marginBottom="14dp" android:text="@string/saved_setups" />
                        <TextView android:id="@+id/advancedChoice" style="@style/SettingsRow" android:layout_marginTop="0dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/advanced_effects_warning" android:textColor="#FFACB8C1" android:textSize="14sp" />
                        <TextView android:id="@+id/openOnStartChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" android:visibility="gone" />
                        <TextView android:id="@+id/followThemeChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" android:text="@string/follow_theme" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/follow_theme_hint" android:textColor="#FFACB8C1" android:textSize="14sp" />
                        <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" android:text="@string/home_settings" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/home_settings_help" android:textColor="#FFACB8C1" android:textSize="14sp" />
                        <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" android:text="@string/tv_settings" />
                    </LinearLayout>
                </LinearLayout>

        </ScrollView>
    </FrameLayout>
</LinearLayout>
