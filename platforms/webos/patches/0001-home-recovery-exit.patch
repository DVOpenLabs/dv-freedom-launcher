diff --git a/native/prototype/filter.c b/native/prototype/filter.c
index ca6f5db..0fd4ec3 100644
--- a/native/prototype/filter.c
+++ b/native/prototype/filter.c
@@ -26,10 +26,12 @@ int filter_event(struct filter*f,const struct ev*e,uint64_t now){
   int kept=0;
   for(int i=0;i<f->count;i++)if(now-f->taps[i]<=2000)f->taps[kept++]=f->taps[i];
   f->taps[kept++]=f->since;f->count=kept;
-  if(kept==3){f->count=0;return RELEASE;}
+  if(kept==3){f->count=0;return EXIT_HOME;}
  }
  return DROP;
 }
+/* Intentional recovery opens LG Home; input loss releases capture without stealing focus. */
+int filter_exit_code(int action){return action==EXIT_HOME?22:action==RELEASE?27:0;}
 /* A long Back opens stock Home once; it never releases the helper. */
 int filter_timeout(struct filter*f,uint64_t now){
  if(f->back&&!f->back_fired&&now>=f->back_since&&now-f->back_since>=1200){f->back_fired=1;return OPEN_LG;}
